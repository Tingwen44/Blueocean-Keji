# OpenAI API Key (用于 LLM 辅助)
OPENAI_API_KEY=sk-your-key-here

# FRED API Key (可选, 申请: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Finnhub API Key (云端 fallback 数据源, 申请: https://finnhub.io/register)
# yfinance 在 Railway 经常被 Yahoo 限流, Finnhub 救场
FINNHUB_API_KEY=

# Tiingo API Key (Phase C ETF 历史价主源, 申请: https://tiingo.com/)
# 支持 SPY/XLK/XLF 等 ETF 日线 (Finnhub 不支持 ETF), 免费 500 requests/day
# Railway 友好, 不 ban IP. 韩股/港股不支持 (任何免费方案都不支持)
TIINGO_API_KEY=

# 数据存储路径
DATABASE_PATH=../data/keji.db

# 代理 (国内访问 yfinance 必需)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
