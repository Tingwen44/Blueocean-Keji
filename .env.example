# OpenAI API Key (用于 LLM 辅助)
OPENAI_API_KEY=sk-your-key-here

# FRED API Key (可选, 申请: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Finnhub API Key (云端 fallback 数据源, 申请: https://finnhub.io/register)
# yfinance 在 Railway 经常被 Yahoo 限流, Finnhub 救场
FINNHUB_API_KEY=

# 数据存储路径
DATABASE_PATH=../data/keji.db

# 代理 (国内访问 yfinance 必需)
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
